rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ATENÇÃO: regras abertas para desenvolvimento/protótipo.
    // O app ainda não tem autenticação. Antes de uso em produção com
    // dados reais, restrinja o acesso (ex.: exigir request.auth != null
    // após implementar Firebase Auth).
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
