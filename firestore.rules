rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Acesso restrito a usuários autenticados (Firebase Auth).
    // Os dados de RH envolvem dados pessoais (LGPD), portanto leitura e
    // escrita exigem login. Refine por papéis/claims quando necessário.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
